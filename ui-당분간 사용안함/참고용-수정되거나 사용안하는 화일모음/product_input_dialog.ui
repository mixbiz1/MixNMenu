      <layout class="QHBoxLayout" name="lay_options">
       <property name="spacing"><number>10</number></property>
       <item><widget class="QCheckBox" name="chk_copy_new"><property name="text"><string>복사신규</string></property></widget></item>
       <item><widget class="QCheckBox" name="chk_dup_check"><property name="text"><string>상품명중복체크</string></property><property name="checked"><bool>true</bool></property></widget></item>
       <item><widget class="QCheckBox" name="chk_touch_menu"><property name="text"><string>터치메뉴에 등록</string></property></widget></item>
      </layout>
     </item>
     <item><spacer name="sp_header"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
