      </layout>
     </item>

     <!-- 우측: 상세 설정 및 데이터 테이블 -->
     <item>
      <layout class="QVBoxLayout" name="lay_right">
       <property name="spacing"><number>6</number></property>

       <!-- 상품 기본정보 & 일괄적용 설정 프레임 -->
       <item>
        <widget class="QFrame" name="frame_item_header">
         <property name="styleSheet"><string notr="true">background-color: #D4D0C8; border: 1px solid #808080;</string></property>
         <layout class="QGridLayout" name="grid_header_fields">
          <property name="leftMargin"><number>8</number></property>
          <property name="topMargin"><number>8</number></property>
          <property name="rightMargin"><number>8</number></property>
          <property name="bottomMargin"><number>8</number></property>
          <property name="horizontalSpacing"><number>6</number></property>
          <property name="verticalSpacing"><number>4</number></property>

          <!-- 상품 라벨 -->
          <item row="0" column="0">
           <widget class="QLabel" name="lbl_prod_code_title">
            <property name="text"><string>상품</string></property>
            <property name="styleSheet"><string notr="true">color: #000080; font-weight: bold;</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="txt_prod_code"/>
          </item>

          <!-- 상품명 형식 -->
          <item row="0" column="2">
           <widget class="QLabel" name="lbl_prod_name_fmt">
            <property name="text"><string>상품명형식</string></property>
            <property name="styleSheet"><string notr="true">color: #000080; font-weight: bold;</string></property>
           </widget>
          </item>
          <item row="0" column="3" colspan="2">
           <widget class="QComboBox" name="cb_name_format">
            <item><property name="text"><string>브랜드+'+'+등급+'+'+중분류+'+'+냉장+'+'+원산지</string></property></item>
           </widget>
          </item>

          <!-- 식육종류/표준부위 & 일괄적용 -->
          <item row="1" column="1">
           <widget class="QLabel" name="lbl_meat_std">
            <property name="text"><string>식육종류/표준부위</string></property>
            <property name="styleSheet"><string notr="true">color: #000080; font-weight: bold;</string></property>
            <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
           </widget>
          </item>
          <item row="1" column="2">
           <widget class="QComboBox" name="cb_meat_std_type"/>
          </item>
          <item row="1" column="3">
           <widget class="QPushButton" name="btn_apply_meat"><property name="text"><string>일괄적용</string></property></widget>
          </item>

          <!-- 대분류 목록 타이틀 및 이력구분 -->
          <item row="2" column="0" colspan="2">
           <widget class="QLabel" name="lbl_category_title">
            <property name="text"><string>상품 [대분류] 목록</string></property>
            <property name="styleSheet"><string notr="true">color: #FF0000; font-weight: bold;</string></property>
           </widget>
          </item>
          <item row="2" column="2">
           <widget class="QLabel" name="lbl_history_type">
            <property name="text"><string>이력구분</string></property>
            <property name="styleSheet"><string notr="true">color: #000080; font-weight: bold;</string></property>
            <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
           </widget>
          </item>
          <item row="2" column="3">
           <widget class="QComboBox" name="cb_history_type"/>
          </item>
          <item row="2" column="4">
           <widget class="QPushButton" name="btn_apply_history"><property name="text"><string>일괄적용</string></property></widget>
          </item>

         </layout>
        </widget>
       </item>

       <!-- 대분류 코드/코드명 그리드 -->
       <item>
        <widget class="QTableWidget" name="tbl_category_list">
         <column><property name="text"><string>코드</string></property></column>
