   <!-- 2. 메인 콘텐츠 (좌측 트리 & 찾기 / 우측 상세 및 테이블) -->
   <item>
    <layout class="QHBoxLayout" name="lay_body">
     <property name="spacing"><number>8</number></property>

     <!-- 좌측: 찾기 영역 + 상품 트리뷰 -->
     <item>
      <layout class="QVBoxLayout" name="lay_left">
       <property name="spacing"><number>4</number></property>
       
       <!-- 찾기 영역 -->
       <item>
        <widget class="QFrame" name="frame_search">
         <property name="styleSheet"><string notr="true">background-color: #D4D0C8; border: 1px solid #808080;</string></property>
         <layout class="QHBoxLayout" name="lay_search_inner">
          <property name="leftMargin"><number>4</number></property>
          <property name="topMargin"><number>4</number></property>
          <property name="rightMargin"><number>4</number></property>
          <property name="bottomMargin"><number>4</number></property>
          <property name="spacing"><number>4</number></property>
          <item><widget class="QLabel" name="lbl_search_code"><property name="text"><string>찾기\n상품코드</string></property></widget></item>
          <item><widget class="QLineEdit" name="txt_search_code"><property name="maximumSize"><size><width>60</width><height>16777215</height></size></property></widget></item>
          <item><widget class="QLabel" name="lbl_search_name"><property name="text"><string>상품명</string></property></widget></item>
          <item><widget class="QLineEdit" name="txt_search_name"/></item>
          <item><widget class="QPushButton" name="btn_find"><property name="text"><string>🔍</string></property><property name="maximumSize"><size><width>30</width><height>22</height></size></property></widget></item>
