 <class>ProductInputDialog</class>
 <widget class="QDialog" name="ProductInputDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1150</width>
    <height>680</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>상품입력</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QDialog#ProductInputDialog {
        background-color: #B0B0B0;
    }
    QLabel {
        font-family: "Gulim", "Dotum", "Malgun Gothic";
        font-size: 12px;
    }
    QPushButton {
        background-color: #D4D0C8;
        border-top: 2px solid #FFFFFF;
        border-left: 2px solid #FFFFFF;
        border-right: 2px solid #808080;
        border-bottom: 2px solid #808080;
        font-family: "Gulim", "Dotum";
        font-size: 12px;
        font-weight: bold;
        min-height: 22px;
        padding: 2px 8px;
    }
    QPushButton:pressed {
        border-top: 2px solid #808080;
        border-left: 2px solid #808080;
        border-right: 2px solid #FFFFFF;
        border-bottom: 2px solid #FFFFFF;
    }
    QLineEdit, QComboBox {
        background-color: #FFFFFF;
        border: 1px solid #707070;
        font-family: "Gulim", "Dotum";
        font-size: 12px;
        padding: 2px;
    }
    QTreeWidget, QTableWidget {
        background-color: #FFFFFF;
        gridline-color: #C0C0C0;
        font-family: "Gulim", "Dotum";
        font-size: 12px;
    }
    QHeaderView::section {
        background-color: #D4D0C8;
        color: #000080;
        font-weight: bold;
        border: 1px solid #808080;
        padding: 4px;
    }
    QCheckBox {
        font-family: "Gulim", "Dotum";
        font-size: 12px;
        font-weight: bold;
    }
   </string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>6</number></property>
   <property name="leftMargin"><number>6</number></property>
   <property name="topMargin"><number>6</number></property>
   <property name="rightMargin"><number>6</number></property>
   <property name="bottomMargin"><number>6</number></property>

   <!-- 1. 최상단 타이틀, 툴바 및 옵션 영역 -->
   <item>
    <layout class="QHBoxLayout" name="lay_top_header">
     <property name="spacing"><number>10</number></property>
     <item>
      <widget class="QLabel" name="lbl_title">
       <property name="minimumSize"><size><width>280</width><height>32</height></size></property>
       <property name="styleSheet">
        <string notr="true">background-color: #3A6EA5; color: #FFFFFF; font-size: 15px; font-weight: bold; border: 2px inset #FFFFFF;</string>
       </property>
       <property name="text">
        <string>  상품입력</string>
       </property>
       <property name="alignment"><set>Qt::AlignVCenter|Qt::AlignLeft</set></property>
      </widget>
     </item>

     <!-- 상단 액션 버튼 그룹 -->
     <item>
      <layout class="QHBoxLayout" name="lay_top_buttons">
       <property name="spacing"><number>4</number></property>
       <item><widget class="QPushButton" name="btn_search"><property name="text"><string>조회 [F7]</string></property></widget></item>
       <item><widget class="QPushButton" name="btn_new"><property name="text"><string>신규 [F2]</string></property></widget></item>
       <item><widget class="QPushButton" name="btn_edit"><property name="text"><string>수정 [F3]</string></property></widget></item>
       <item><widget class="QPushButton" name="btn_delete"><property name="text"><string>삭제 [F6]</string></property></widget></item>
       <item><widget class="QPushButton" name="btn_cancel"><property name="text"><string>취소 [F5]</string></property></widget></item>
       <item><widget class="QPushButton" name="btn_save"><property name="text"><string>저장 [F4]</string></property></widget></item>
       <item><widget class="QPushButton" name="btn_close"><property name="text"><string>닫기</string></property></widget></item>
      </layout>
     </item>

     <!-- 우측 옵션 체크박스 그룹 -->
