<ui version="4.0">
 <class>EmployeeInputDialog</class>
 <widget class="QDialog" name="EmployeeInputDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1050</width>
    <height>620</height>
