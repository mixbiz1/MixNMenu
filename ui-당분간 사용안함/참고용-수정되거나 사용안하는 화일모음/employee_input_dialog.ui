  </property>
  <property name="windowTitle">
   <string>사원입력</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QDialog#EmployeeInputDialog {
        background-color: #B0B0B0;
    }
    QLabel {
        font-family: "Gulim", "Dotum", "Malgun Gothic";
        font-size: 12px;
    }
    QPushButton {
        background-color: #D4D0C8;
        border-top: 2px solid #FFFFFF;
        border-left: 2px solid #FFFFFF;
        border-right: 2px solid #808080;
        border-bottom: 2px solid #808080;
        font-family: "Gulim", "Dotum";
        font-size: 12px;
        font-weight: bold;
        min-height: 22px;
        padding: 2px 8px;
    }
    QPushButton:pressed {
        border-top: 2px solid #808080;
        border-left: 2px solid #808080;
        border-right: 2px solid #FFFFFF;
        border-bottom: 2px solid #FFFFFF;
    }
    QLineEdit {
        background-color: #FFFFFF;
        border: 1px solid #707070;
        font-family: "Gulim", "Dotum";
        font-size: 12px;
        padding: 2px;
    }
    QTableWidget {
        background-color: #FFFFFF;
        gridline-color: #C0C0C0;
        font-family: "Gulim", "Dotum";
        font-size: 12px;
    }
    QHeaderView::section {
        background-color: #D4D0C8;
        color: #000080;
        font-weight: bold;
        border: 1px solid #808080;
        padding: 4px;
    }
    QFrame#frame_details {
        background-color: #D4D0C8;
        border: 2px inset #FFFFFF;
    }
    QFrame#frame_required {
        background-color: #C8E6C9;
        border: 1px solid #4CAF50;
    }
   </string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>6</number></property>
   <property name="leftMargin"><number>6</number></property>
   <property name="topMargin"><number>6</number></property>
   <property name="rightMargin"><number>6</number></property>
   <property name="bottomMargin"><number>6</number></property>

   <!-- 1. 최상단 타이틀 & 툴바 영역 -->
