      <layout class="QVBoxLayout" name="col_1">
       <property name="spacing"><number>4</number></property>
       <item><widget class="QLabel" name="lbl_cat_code"><property name="text"><string>&lt;&lt; 코드관리 &gt;&gt;</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
