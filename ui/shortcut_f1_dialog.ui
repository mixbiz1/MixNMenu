       <item><spacer name="sp_col2_2"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="maximumSize"><size><width>20</width><height>15</height></size></property></spacer></item>

       <item><widget class="QPushButton" name="btn_domestic_beef"><property name="text"><string>국내산쇠고기</string></property></widget></item>
