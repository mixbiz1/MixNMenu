 <class>ShortcutF1Dialog</class>
 <widget class="QDialog" name="ShortcutF1Dialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1000</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>단축메뉴 (F1)</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QDialog#ShortcutF1Dialog {
        background-color: #B0B0B0;
    }
    QLabel {
        font-family: "Gulim", "Dotum", "Malgun Gothic";
        font-size: 12px;
        font-weight: bold;
        color: #000080;
    }
    QPushButton {
        background-color: #FFFFFF;
        border-top: 2px solid #FFFFFF;
        border-left: 2px solid #FFFFFF;
        border-right: 2px solid #808080;
        border-bottom: 2px solid #808080;
        font-family: "Gulim", "Dotum";
        font-size: 12px;
        font-weight: bold;
        color: #000000;
        min-height: 25px;
    }
    QPushButton:pressed {
        border-top: 2px solid #808080;
        border-left: 2px solid #808080;
        border-right: 2px solid #FFFFFF;
        border-bottom: 2px solid #FFFFFF;
    }
   </string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>10</number></property>
   <property name="leftMargin"><number>10</number></property>
   <property name="topMargin"><number>10</number></property>
   <property name="rightMargin"><number>10</number></property>
   <property name="bottomMargin"><number>10</number></property>

   <!-- 1. 최상단 상호 및 사용기한 정보 바 -->
   <item>
    <layout class="QHBoxLayout" name="lay_top_info">
     <property name="spacing"><number>10</number></property>
     <item>
      <widget class="QLabel" name="lbl_company_info">
       <property name="minimumSize"><size><width>220</width><height>26</height></size></property>
       <property name="styleSheet">
        <string notr="true">background-color: #D4D0C8; border-top: 2px solid #808080; border-left: 2px solid #808080; border-right: 2px solid #FFFFFF; border-bottom: 2px solid #FFFFFF; color: #000080; font-size: 12px;</string>
       </property>
       <property name="text">
        <string>(주)믹스비즈  0505-810-1001</string>
       </property>
       <property name="alignment"><set>Qt::AlignCenter</set></property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="lbl_expire_info">
       <property name="minimumSize"><size><width>320</width><height>26</height></size></property>
       <property name="styleSheet">
        <string notr="true">background-color: #D4D0C8; border-top: 2px solid #808080; border-left: 2px solid #808080; border-right: 2px solid #FFFFFF; border-bottom: 2px solid #FFFFFF; color: #000080; font-size: 12px;</string>
       </property>
       <property name="text">
        <string>사용기한 : 무제한 (영구 라이선스) [남은일수 : 무제한]</string>
       </property>
       <property name="alignment"><set>Qt::AlignCenter</set></property>
      </widget>
     </item>
     <item>
      <spacer name="spacer_top">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
      </spacer>
     </item>
    </layout>
   </item>

   <!-- 2. 메인 버튼 그리드 영역 (카테고리별 컬럼) -->
   <item>
    <layout class="QHBoxLayout" name="lay_columns">
     <property name="spacing"><number>15</number></property>

     <!-- 컬럼 1: 코드관리 & 기초등록 & 경비전표관리 -->
