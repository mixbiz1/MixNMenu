       <item><widget class="QPushButton" name="btn_basic_bal"><property name="text"><string>기초잔액입력</string></property></widget></item>
       <item><spacer name="sp_col1_2"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="maximumSize"><size><width>20</width><height>10</height></size></property></spacer></item>

       <item><widget class="QLabel" name="lbl_cat_margin"><property name="text"><string>&lt;&lt; 매출이익정산 &gt;&gt;</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
